# Salin ke .env.local untuk `vercel dev`; di Vercel isi lewat Settings > Environment Variables
SESSION_SECRET=isi-string-acak-panjang          # node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
STORE=n8n                                       # n8n | supabase

# Jika STORE=n8n
N8N_BASE_URL=https://n8n-anda.example.com
N8N_SECRET=string-acak-yang-sama-dengan-credential-n8n

# Jika STORE=supabase (atau untuk dipakai n8n lewat Postgres, lihat README)
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_KEY=service_role_key_JANGAN_masuk_frontend
